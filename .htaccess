# Ibtekr Operation System - static app on Hostinger shared hosting (Apache / LiteSpeed).
# Uploaded with the rest of app/ to the subdomain's document root.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .js .css
FileETag None

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # No inline <script>, on*= attributes or eval in app/ (see task-7-report.md). cdnjs is for the
  # lazy-loaded export libraries (xlsx, html2canvas). Inline styles come from the prototype.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; connect-src 'self' https://fsynculhaupcktzkfkdd.supabase.co wss://fsynculhaupcktzkfkdd.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 7 days"
  ExpiresByType font/woff "access plus 7 days"
</IfModule>

# The entry page and the config must always be revalidated, so a redeploy takes effect at once.
<FilesMatch "^(index\.html|config\.js)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires
  </IfModule>
</FilesMatch>
