# Ibtekr Operation System - static app on Hostinger shared hosting (Apache / LiteSpeed).
# Deployed with the rest of app/ to the subdomain's document root by Hostinger's Git auto-deployment
# of the `deploy` branch (see tools/deploy.md section 4.3).

Options -Indexes
# The document root is a Git checkout (Hostinger Git deploy of the `deploy` branch): never serve
# the repository metadata or any other dot-path.
RedirectMatch 404 "(^|/)\.(git|svn|hg|env)(/|$)"
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .js .css

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HTTPS only for a year on this host (Force HTTPS is on in hPanel). No includeSubDomains: other *.ibtekr.club hosts are not ours to pin.
  Header always set Strict-Transport-Security "max-age=31536000"
  # No inline <script>, on*= attributes or eval in app/ (see task-7-report.md). The lazy-loaded export libraries
  # (blocks 10, 17, 28) are vendored under js/vendor/ (README.md there), so every script is same-origin.
  # Inline styles come from the prototype. blob: images: the share-as-image fallback (blocks 10, 28) shows its
  # canvas as URL.createObjectURL(blob); only our own scripts (script-src 'self') can mint one.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' https://fsynculhaupcktzkfkdd.supabase.co wss://fsynculhaupcktzkfkdd.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Our html/js/css carry no version suffix, so browsers revalidate them on every load (cheap 304s via
# ETag): after a redeploy no client mixes a fresh index.html with stale blocks or adapters.
<FilesMatch "\.(html|js|css)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires
  </IfModule>
</FilesMatch>

# The vendored supabase-js is pinned (js/vendor/README.md) and changes rarely: cache it for 7 days.
<Files "supabase.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</Files>
