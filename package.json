{
  "name": "ibtekr-operation-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "split": "node tools/split-prototype.mjs",
    "lock": "node tools/lock-blocks.mjs",
    "serve": "npx http-server app -p 4173 -c-1",
    "e2e": "npx playwright test -c tests/playwright.config.mjs",
    "db:test": "bash tools/db-test.sh --stub",
    "deno:check": "deno check --node-modules-dir=none --no-lock supabase/functions/woo-webhook/index.ts supabase/functions/woo-sync/index.ts supabase/functions/ai-content/index.ts",
    "deno:test": "deno test --allow-env --allow-net=127.0.0.1 --node-modules-dir=none --no-lock supabase/functions",
    "semgrep": "semgrep scan --metrics=off --config p/javascript --config p/secrets --severity ERROR --error --exclude app/js/blocks --exclude app/js/vendor ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "http-server": "14.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
